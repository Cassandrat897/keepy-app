rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() 
        && request.auth.token.get('email', '').lower() == 'cassandrat897@gmail.com'
        && request.auth.token.get('email_verified', false) == true; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // ====== USERS ======
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ====== CONNECTION TEST ======
    match /test/connection {
      allow get: if true;
    }

    // ====== FOLDERS ======
    function isValidFolder(data) {
      return data.keys().size() >= 2
        && data.keys().size() <= 6
        && data.name is string && data.name.size() <= 200
        && data.userId is string && data.userId == request.auth.uid;
    }

    match /folders/{folderId} {
      allow get: if isSignedIn() && isValidId(folderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                   && isValidId(folderId)
                   && isValidFolder(incoming());
      allow update: if isSignedIn()
                   && isValidId(folderId)
                   && existing().userId == request.auth.uid
                   && incoming().userId == existing().userId
                   && isValidFolder(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['name']);
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // ====== CATEGORIES ======
    function isValidCategory(data) {
       return data.keys().size() >= 3
        && data.keys().size() <= 8
        && data.name is string && data.name.size() <= 200
        && data.color is string && data.color.size() <= 100
        && data.userId is string && data.userId == request.auth.uid
        && (data.get('parentId', '') is string)
        && (data.get('folderId', '') is string);
    }

    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                   && isValidId(categoryId)
                   && isValidCategory(incoming());
      allow update: if isSignedIn()
                   && isValidId(categoryId)
                   && existing().userId == request.auth.uid
                   && incoming().userId == existing().userId
                   && isValidCategory(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'parentId', 'folderId']);
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // ====== PROFILES ======
    function isValidProfile(data) {
       return data.keys().size() >= 5
        && data.keys().size() <= 10
        && data.username is string && data.username.size() <= 2000
        && data.platform is string && data.platform.size() <= 100
        && data.categoryId is string && data.categoryId.size() <= 128
        && data.createdAt is number
        && data.userId is string && data.userId == request.auth.uid
        && (data.get('displayName', '') is string)
        && (data.get('notes', '') is string);
    }

    match /profiles/{profileId} {
      allow get: if isSignedIn() && isValidId(profileId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                   && isValidId(profileId)
                   && isValidProfile(incoming());
      allow update: if isSignedIn()
                   && isValidId(profileId)
                   && existing().userId == request.auth.uid
                   && incoming().userId == existing().userId
                   && isValidProfile(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'platform', 'categoryId', 'displayName', 'notes']);
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // ====== SHARED LISTS ======
    match /shared_lists/{shareId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
